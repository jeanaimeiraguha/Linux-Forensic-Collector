{
  "meta": {
    "org_name": "Example Organization",
    "report_classification": "CONFIDENTIAL",
    "report_contact": "security-team@example.org",
    "template_version": 1
  },
  "collection": {
    "scope_paths": ["$HOME"],
    "include_hidden_paths": false,
    "cross_filesystems": false,
    "max_depth": 10,
    "max_files": 100000,
    "large_file_threshold_mb": 500,
    "json_max_inventory_rows": 5000,
    "modules": {
      "system": true,
      "filesystem": true,
      "media": true,
      "browser": true,
      "network": true,
      "software": true
    }
  },
  "smtp": {
    "enabled": false,
    "host": "smtp.example.org",
    "port": 587,
    "tls_mode": "starttls",
    "timeout_seconds": 30,
    "username_env": "LFC_SMTP_USERNAME",
    "password_env": "LFC_SMTP_PASSWORD",
    "from_addr": "lfc-reports@example.org",
    "to_addr": ["jeanaiameiraguha@gmail.com"],
    "max_attachment_mb": 20,
    "attach_format": "zip",
    "subject_prefix": "[LFC]"
  },
  "report": {
    "include_full_inventory_in_json": false,
    "company_footer": "Generated by Linux Forensic Collector (LFC). Handle according to your organization's data classification policy."
  }
}
